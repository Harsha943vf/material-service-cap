POST http://localhost:4004/odata/v4/shipment/closeShipment
Authorization: Basic manager:manager123
Content-Type: application/json

{
  "shipmentID": 101
}


### 33. Verify Shipment Is Closed
GET http://localhost:4004/odata/v4/shipment/Shipments(101)
Authorization: Basic manager:manager123


### 34. Close Already Closed Shipment
# Expected: 409 - Shipment is already closed
POST http://localhost:4004/odata/v4/shipment/closeShipment
Authorization: Basic manager:manager123
Content-Type: application/json

{
  "shipmentID": 101
}


### 35. Assign Carrier to Closed Shipment
# Expected: 409 - Closed shipments cannot be modified
POST http://localhost:4004/odata/v4/shipment/assignCarrier
Authorization: Basic operator:operator123
Content-Type: application/json

{
  "shipmentID": 101,
  "carrierID": 2
}


### 36. Report Exception on Closed Shipment
# Expected: 409 - Closed shipments cannot be modified
POST http://localhost:4004/odata/v4/shipment/reportException
Authorization: Basic operator:operator123
Content-Type: application/json

{
  "shipmentID": 101,
  "reason": "Testing closed shipment validation"
}


### 37. Close Nonexistent Shipment
# Expected: 404
POST http://localhost:4004/odata/v4/shipment/closeShipment
Authorization: Basic manager:manager123
Content-Type: application/json

{
  "shipmentID": 99999
}