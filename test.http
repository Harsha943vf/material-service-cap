############################################
# MATERIAL SERVICE
############################################

### 1. Create Material - Success
POST http://localhost:4004/odata/v4/material/Materials
Content-Type: application/json

{
  "ID": 1005,
  "name": "Headset",
  "plant": "3000",
  "quantity": 30
}


### 2. Create Material - Invalid Quantity
POST http://localhost:4004/odata/v4/material/Materials
Content-Type: application/json

{
  "ID": 1006,
  "name": "Monitor",
  "plant": "3000",
  "quantity": -10
}


### 3. Check Quantity - Success
POST http://localhost:4004/odata/v4/material/checkQuantity
Content-Type: application/json

{
  "quantity": 10
}


### 4. Check Quantity - Invalid
POST http://localhost:4004/odata/v4/material/checkQuantity
Content-Type: application/json

{
  "quantity": -5
}


### 5. Get Material Quantity - Action
POST http://localhost:4004/odata/v4/material/getMaterialQuantity
Content-Type: application/json

{
  "materialID": 1001
}


### 6. Read Material Quantity - Function
GET http://localhost:4004/odata/v4/material/readMaterialQuantity(materialID=1001)


### 7. Set Material Quantity - Success
POST http://localhost:4004/odata/v4/material/setMaterialQuantity
Content-Type: application/json

{
  "materialID": 1001,
  "quantity": 50
}


### 8. Verify Material Quantity
GET http://localhost:4004/odata/v4/material/Materials(1001)


### 9. Set Material Quantity - Invalid Quantity
POST http://localhost:4004/odata/v4/material/setMaterialQuantity
Content-Type: application/json

{
  "materialID": 1001,
  "quantity": -5
}


### 10. Set Material Quantity - Material Not Found
POST http://localhost:4004/odata/v4/material/setMaterialQuantity
Content-Type: application/json

{
  "materialID": 99999,
  "quantity": 50
}


### 11. Read Quantity Before Rollback Test
GET http://localhost:4004/odata/v4/material/Materials(1001)


### 12. Test Transaction Rollback
# Expected: 400
POST http://localhost:4004/odata/v4/material/testRollback
Content-Type: application/json

{
  "materialID": 1001
}


### 13. Verify Rollback
# Quantity should NOT become 999.
GET http://localhost:4004/odata/v4/material/Materials(1001)



############################################
# SHIPMENT SERVICE - REGION READ ACCESS
############################################

### 14. IN Viewer - Should See IN Shipment Only
GET http://localhost:4004/odata/v4/shipment/Shipments
Authorization: Basic viewer:viewer123


### 15. US Viewer - Should See US Shipment Only
GET http://localhost:4004/odata/v4/shipment/Shipments
Authorization: Basic us.viewer:us123


### 16. Unknown User - Should Fail Authentication
GET http://localhost:4004/odata/v4/shipment/Shipments
Authorization: Basic unknown:wrong



############################################
# SHIPMENT SERVICE - ROLE AUTHORIZATION
############################################

### 17. Viewer Cannot Assign Carrier
# Expected: 403
POST http://localhost:4004/odata/v4/shipment/assignCarrier
Authorization: Basic viewer:viewer123
Content-Type: application/json

{
  "shipmentID": 101,
  "carrierID": 1
}


### 18. Operator Cannot Close Shipment
# Expected: 403
POST http://localhost:4004/odata/v4/shipment/closeShipment
Authorization: Basic operator:operator123
Content-Type: application/json

{
  "shipmentID": 101
}



############################################
# CARRIER API
############################################

### 19. Read Simulated Carrier API
GET http://localhost:4004/carrier-api/Carriers
Authorization: Basic manager:manager123



############################################
# ASSIGN CARRIER
############################################

### 20. Operator Assigns Active Carrier to IN Shipment
# Expected: 200
POST http://localhost:4004/odata/v4/shipment/assignCarrier
Authorization: Basic operator:operator123
Content-Type: application/json

{
  "shipmentID": 101,
  "carrierID": 1
}


### 21. Verify Carrier Assignment
GET http://localhost:4004/odata/v4/shipment/Shipments(101)?$expand=carrier
Authorization: Basic operator:operator123


### 22. Assign Inactive Carrier
# Expected: 409 - Carrier is inactive
POST http://localhost:4004/odata/v4/shipment/assignCarrier
Authorization: Basic operator:operator123
Content-Type: application/json

{
  "shipmentID": 101,
  "carrierID": 3
}


### 23. Assign Nonexistent Carrier
# Expected: 404
POST http://localhost:4004/odata/v4/shipment/assignCarrier
Authorization: Basic operator:operator123
Content-Type: application/json

{
  "shipmentID": 101,
  "carrierID": 99999
}


### 24. Assign Carrier to Nonexistent Shipment
# Expected: 404
POST http://localhost:4004/odata/v4/shipment/assignCarrier
Authorization: Basic operator:operator123
Content-Type: application/json

{
  "shipmentID": 99999,
  "carrierID": 1
}



